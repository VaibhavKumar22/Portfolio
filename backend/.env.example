PORT=4000
# Comma-separated browser origins. Use * alone to allow any origin (simplest for a public contact form).
# Or list localhost + your Vercel URLs. Optional CORS_EXTRA_ORIGINS for a custom domain (e.g. https://yourdomain.com).
CORS_ORIGIN=*
# CORS_EXTRA_ORIGINS=https://your-custom-domain.com

# Gmail account (sender)
SMTP_USER=vaibjais123456@gmail.com

# Gmail App Password (16 chars, no spaces)
SMTP_PASS=your_gmail_app_password

# Recipient inbox for contact messages
CONTACT_TO_EMAIL=vaibjais123456@gmail.com

# Optional: if Gmail SMTP times out on Render (ETIMEDOUT), add a Resend API key (HTTPS only — no SMTP).
# https://resend.com — then set RESEND_FROM_EMAIL to a verified sender when you add a domain.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
