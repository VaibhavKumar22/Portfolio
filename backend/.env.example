PORT=4000
# Comma-separated browser origins. Use * alone to allow any origin (simplest for a public contact form).
# Or list localhost + your Vercel URLs. Optional CORS_EXTRA_ORIGINS for a custom domain (e.g. https://yourdomain.com).
CORS_ORIGIN=*
# CORS_EXTRA_ORIGINS=https://your-custom-domain.com

# --- Email (production on Render: use SendGrid — same as hardware-sanitary-app) ---
# https://sendgrid.com — create API key, verify a single sender or domain for "from".
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender in SendGrid (often same as your Gmail).
SENDGRID_FROM_EMAIL=vaibjais123456@gmail.com

# Where contact form messages are delivered
CONTACT_TO_EMAIL=vaibjais123456@gmail.com

# --- Optional: local dev without SendGrid (Gmail SMTP — can time out on Render) ---
# SMTP_USER=vaibjais123456@gmail.com
# SMTP_PASS=your_gmail_app_password

# --- Optional: Resend instead of SendGrid (HTTPS only) ---
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
